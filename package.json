{
  "name": "@meijie/vue-fireworks",
  "version": "0.3.0",
  "description": "Canvas 礼花/烟花特效组件，支持 Vue 2 与 Vue 3，可配置粒子数、颜色、形状、固定位置、跟随鼠标、拖尾与发光。",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vue2": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vue3": {
      "types": "./dist/vue3.d.ts",
      "import": "./dist/vue3.js",
      "require": "./dist/vue3.cjs"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js",
      "require": "./dist/engine.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "vue",
    "vue2",
    "vue3",
    "fireworks",
    "canvas",
    "animation",
    "烟花",
    "礼花"
  ],
  "scripts": {
    "build": "FORMAT=es vite build && FORMAT=cjs vite build && cp types/*.d.ts dist/",
    "dev": "vite --config demo/vite.config.js",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^2.6.0 || ^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meijie9412/vue-fireworks.git"
  },
  "homepage": "https://github.com/meijie9412/vue-fireworks#readme",
  "bugs": {
    "url": "https://github.com/meijie9412/vue-fireworks/issues"
  },
  "author": "meijie",
  "license": "MIT",
  "devDependencies": {
    "vite": "^4.5.14",
    "vitest": "^2.1.9"
  }
}
